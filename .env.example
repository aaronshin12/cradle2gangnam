# 공공데이터포털 - 국토교통부 아파트매매 실거래가 (RTMSDataSvcAptTradeDev)
# 디코딩(혹은 인코딩) 된 ServiceKey 그대로 사용 가능. 코드에서 URL 인코딩 처리.
DATA_GO_KR_SERVICE_KEY=

# 카카오 디벨로퍼스
# REST API 키 (서버에서만 사용: 로컬 + 모빌리티 길찾기 공통)
KAKAO_REST_API_KEY=
# JavaScript 키 (지도 SDK용, 클라이언트 노출. 카카오 콘솔에서 도메인 제한 권장)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Google Gemini
GEMINI_API_KEY=

# ODsay LAB (대중교통 길찾기)
ODSAY_API_KEY=
